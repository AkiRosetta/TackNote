<?xml version="1.0" encoding="utf-8"?>
<!-- One TextView per line, so each line can be tapped on its own: a to-do
     ticks, anything else opens the app. Lines past the twelfth are not shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_0"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/line_0"
        style="@style/WidgetLine"
        android:text="@string/widget_empty" />
    <TextView
        android:id="@+id/line_1"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_2"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_3"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_4"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_5"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_6"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_7"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_8"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_9"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_10"
        style="@style/WidgetLine"
        android:visibility="gone" />
    <TextView
        android:id="@+id/line_11"
        style="@style/WidgetLine"
        android:visibility="gone" />
</LinearLayout>
