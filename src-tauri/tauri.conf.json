{
  "productName": "TackNote",
  "version": "0.1.0",
  "identifier": "io.github.akirosetta.tacknote",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TackNote",
        "width": 900,
        "height": 640,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
